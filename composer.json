{
    "name": "webmasterskaya/joomla-microschema",
    "description": "A suite of Joomla extensions for generating Schema.org structured data in JSON-LD format",
    "keywords": [
        "joomla",
        "json-ld",
        "schema.org",
        "structured-data"
    ],
    "homepage": "https://github.com/webmasterskaya/joomla-microschema",
    "license": "GPL-2.0-or-later",
    "type": "project",
    "support": {
        "issues": "https://github.com/webmasterskaya/joomla-microschema/issues",
        "source": "https://github.com/webmasterskaya/joomla-microschema"
    },
    "require": {
        "php": ">=8.2",
        "ext-simplexml": "*"
    },
    "require-dev": {
        "codeception/codeception": "^5.3",
        "codeception/module-db": "^3.2",
        "codeception/module-phpbrowser": "^4.0",
        "friendsofphp/php-cs-fixer": "*",
        "phpunit/phpunit": "^11.5",
        "sovmart/codeception-module-joomla": "dev-main"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/SovMart-Team/Codeception-Module-Joomla.git"
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "tests/Administrator/",
            "tests/Site/"
        ]
    },
    "scripts": {
        "test": "codecept run Unit",
        "test:functional": [
            "codecept run Administrator",
            "codecept run Site"
        ],
        "test:js": "node --test tests/js/schema-editor-state.test.mjs"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.2"
        },
        "sort-packages": true,
        "allow-plugins": {}
    }
}
