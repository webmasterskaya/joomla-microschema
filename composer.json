{
    "name": "webmasterskaya/joomla-microschema",
    "description": "A suite of Joomla extensions for generating Schema.org structured data in JSON-LD format",
    "keywords": [
        "joomla",
        "json-ld",
        "schema.org",
        "structured-data"
    ],
    "homepage": "https://github.com/webmasterskaya/joomla-microschema",
    "license": "GPL-2.0-or-later",
    "type": "project",
    "support": {
        "issues": "https://github.com/webmasterskaya/joomla-microschema/issues",
        "source": "https://github.com/webmasterskaya/joomla-microschema"
    },
    "require": {
        "php": ">=8.2",
        "ext-simplexml": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.2"
        },
        "sort-packages": true
    }
}
